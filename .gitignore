# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
# tasks/ was ignored here, grouped with the Python build artifacts above, and
# it is not one. It is the graded task corpus the harness actually runs from,
# so ignoring it left the bytes being graded untracked and unversioned while
# the delivered copies under dataset/ and samples/ were committed: two Harbor
# bundles that no commit describes, which is C-GAP-HARNESS-TASK-CORPUS-GITIGNORED.
# A run is not reproducible from the repository if the corpus it grades is not
# in the repository.
output/
delivery_output/
# World data injected into light-servers at boot. Never committed: it is
# per-run input, and anything it contains leaves the run inside trajectory.json.
corpus_additions/
*.egg-info

# Virtual environments
.venv
.serena
.sisyphus


# Ruff
.ruff_cache

.DS_Store
https:/

.env

# Node.js (services/agent-harness)
node_modules/
package-lock.json.bak

# Logs
logs/
*.log

# Eval run outputs (per-run dirs: outputs, logs, scoring)
results/

/.tokensave

/.scoring-venv312

/model-training-ckpt-codec-recovery
/vendor/ccbridge/.venv

/vendor/ccbridge/.litellm-venv
/Archive
# Judge backend config, mounted into the task container with the scoring code.
# Carries the local codex-bridge API key. Generated by `make judge-config`.
/services/scoring/judge_backend.json

# tiktoken vocab cache (pre-populated blob, fetched from network)
.cache/
